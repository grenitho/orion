# Orion backend configuration — copy to .env and fill in your own values.
# This file is committed; .env is NOT.

# --- Tier 1: Gemini (add as many numbered keys as you want; they are rotated) ---
GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
DEFAULT_MODEL=gemini/gemini-3.5-flash-lite

# --- Tier 2: first-class providers — one numbered group per account ---
# Optional (UPDATE-011+). Any number of groups: PROVIDER_1_*, PROVIDER_2_*,
# ... up to PROVIDER_99_*. Groups are tried in numeric order (1 first) and
# models inside a group in the order you write them — configured order IS
# the priority, no shuffling. A group only joins the queue when BOTH
# API_KEY and MODELS are filled; incomplete groups are skipped with a
# warning in the backend log instead of crashing anything.
#
# Model naming: a name containing "/" goes to LiteLLM verbatim
# (anthropic/claude-..., deepseek/..., groq/...); a name WITHOUT "/" gets
# the openai/ prefix, which is correct for every OpenAI-compatible
# endpoint (i.e. whenever BASE_URL is set).
#
#   Recipe 1 — DeepSeek (native key):
#        PROVIDER_1_NAME=DeepSeek
#        PROVIDER_1_API_KEY=sk-...
#        PROVIDER_1_MODELS=deepseek/deepseek-chat, deepseek/deepseek-reasoner
#
#   Recipe 2 — Qwen / DashScope (OpenAI-compatible endpoint):
#        PROVIDER_2_NAME=Qwen
#        PROVIDER_2_API_KEY=sk-...
#        PROVIDER_2_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#        PROVIDER_2_MODELS=qwen3-coder-plus, qwen-max
#
#   Recipe 3 — Anthropic Claude (native LiteLLM prefix, no BASE_URL):
#        PROVIDER_3_NAME=Claude
#        PROVIDER_3_API_KEY=sk-ant-...
#        PROVIDER_3_MODELS=anthropic/claude-sonnet-4-5
#        PROVIDER_3_TEMPERATURE=0.3
#
#   Recipe 4 — OpenAI direct (or Groq: https://api.groq.com/openai/v1):
#        PROVIDER_4_API_KEY=sk-...
#        PROVIDER_4_BASE_URL=https://api.openai.com/v1
#        PROVIDER_4_MODELS=gpt-5, gpt-5-mini
#
# PROVIDER_1_NAME=
# PROVIDER_1_API_KEY=
# PROVIDER_1_BASE_URL=
# PROVIDER_1_MODELS=
# PROVIDER_1_TEMPERATURE=

# --- Tier 3: legacy shared fallback endpoint (optional, pre-0.0.9 style) ---
# ONE key + ONE endpoint for everything; still fully supported and runs
# after every Gemini key and every PROVIDER_<N>_* group has failed.
# Two easy recipes:
#
#   A) OpenRouter — ONE key unlocks OpenAI, Anthropic, DeepSeek, Qwen, ...
#        FALLBACK_API_KEY=sk-or-...
#        FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#        FALLBACK_MODELS=openai/gpt-5, anthropic/claude-sonnet-4-5, deepseek/deepseek-reasoner
#
#   B) Direct provider (one endpoint at a time):
#        OpenAI    https://api.openai.com/v1                                models: gpt-5, gpt-5-mini
#        DeepSeek  https://api.deepseek.com                                 models: deepseek-chat, deepseek-reasoner
#        Qwen      https://dashscope-intl.aliyuncs.com/compatible-mode/v1   models: qwen3-coder-plus, qwen-max
#        Groq      https://api.groq.com/openai/v1                           models: llama-3.3-70b-versatile
#
# Leave the Gemini keys empty to make a lower-tier model your effective
# primary. Restart the backend after editing this file.
# Full guide: docs/PANDUAN_SETUP.md (LLM section).
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODELS=

# --- Tier 4: Cloudflare fallback (optional) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODELS=

# --- Resilience & quality knobs ---
LLM_TIMEOUT=60
LLM_MAX_RETRIES_PER_MODEL=2
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=32768
LLM_BACKOFF_BASE=1.5
LLM_BACKOFF_CAP=20.0
ORION_MAX_TODO_NUDGE=10
ORION_MAX_VERIFIKASI=2
LOG_LEVEL=INFO
