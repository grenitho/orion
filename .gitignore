# ============================================================================
# .gitignore untuk proyek Python — ORION
# Salin menjadi .gitignore di root proyek.
# ============================================================================

# ---- RAHASIA & KONFIGURASI LOKAL (paling penting) ----
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
secrets.*
secret.*
credentials
credentials.*
credential*.json
.npmrc
.netrc
.pypirc
.aws/
.gcloud/
.kube/
*.token
*_token.txt
.orion
.vscode


# ---- DATA RUNTIME (sering memuat API key di dalam prompt/log) ----
*.log
logs/
log/
sessions/
session/
history/
transcripts/
.orion/
.cache/
*.sqlite
*.sqlite3
*.db
*.jsonl
*.ndjson
*.dump

# ---- PYTHON ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.nose/
nosetests.xml
*.cover
.hypothesis/
.pytype/
.pyre/
.pyright/
celerybeat-schedule
celerybeat.pid

# ---- BUILD / DIST ----
build/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
target/
var/
wheels/
share/python-wheels/
MANIFEST
out/
coverage/

# ---- NODE (kalau ada bagian frontend) ----
node_modules/
.npm/
.yarn/
.pnp.*
.next/
.nuxt/
.output/
.parcel-cache/
.turbo/
.svelte-kit/
.vite/

# ---- EDITOR / IDE ----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# >>> ORION-37: artefak yang tidak boleh masuk repo publik

*.vsix    # kemasan extension; VSIX lama mengandung .orion/session_history.json

orion/dist/    # hasil build extension

orion/node_modules/    # dependensi extension
